# ═══════════════════════════════════════════════════════════════════════════════
# Granary — Environment Variables
# Copy this file to .env and fill in every value marked  ← CHANGE THIS
# Never commit .env to version control.
# ═══════════════════════════════════════════════════════════════════════════════

# ─── App ────────────────────────────────────────────────────────────────────
APP_NAME="Granary"
APP_ENV=production                           # development | production
APP_SECRET_KEY=change-this-to-a-long-random-secret-min-64-chars   # ← CHANGE THIS
APP_URL=https://granary.example.com        # Public HTTPS URL (no trailing slash)
DEBUG=false

# ─── Internal routing ────────────────────────────────────────────────────────
# INTERNAL_API_URL  — Docker-internal address used by the Next.js server for
#   API rewrites.  Must point directly to the backend container.  NEVER set
#   this to the public domain; that creates an http→https redirect loop.
# API_URL           — Same as INTERNAL_API_URL in most Docker setups.
INTERNAL_API_URL=http://backend:8000
API_URL=http://backend:8000

# Signal service public WebSocket URL (used in NEXT_PUBLIC_SIGNAL_URL build arg)
# Nginx proxies /ws/signal → signal container port 3003.  Must end in /ws/signal.
SIGNAL_URL=wss://granary.example.com/ws/signal   # or ws://localhost:3003 for dev

# ─── Database ────────────────────────────────────────────────────────────────
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=granary
POSTGRES_USER=granary
POSTGRES_PASSWORD=change-this-db-password        # ← CHANGE THIS
DATABASE_URL=postgresql://granary:change-this-db-password@db:5432/granary   # ← match password above

# ─── Redis ───────────────────────────────────────────────────────────────────
# Redis requires a password (openssl rand -hex 32); the URLs below must carry it
REDIS_PASSWORD=change-this-redis-password                          # ← CHANGE THIS
REDIS_URL=redis://:change-this-redis-password@redis:6379/0
CELERY_BROKER_URL=redis://:change-this-redis-password@redis:6379/1
CELERY_RESULT_BACKEND=redis://:change-this-redis-password@redis:6379/2

# ─── Auth / JWT ──────────────────────────────────────────────────────────────
# Each of these is its own value: generate each with `openssl rand -hex 32`.
# NEXTAUTH_SECRET: the website's session key. SIGNAL_TICKET_KEY: call tickets (backend + signal service).
# INTERNAL_AUTH_TOKEN: the website tells the backend the visitor's address with it (login throttling).
NEXTAUTH_SECRET=change-this-nextauth-secret                        # ← CHANGE THIS
SIGNAL_TICKET_KEY=change-this-signal-ticket-key-32-chars-min       # ← CHANGE THIS
INTERNAL_AUTH_TOKEN=change-this-internal-auth-token-32-chars-min   # ← CHANGE THIS
# Generate with: openssl rand -hex 64
JWT_SECRET_KEY=change-this-to-another-long-random-secret-key     # ← CHANGE THIS
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30
# Seconds a just-rotated refresh token is still accepted, so parallel requests or several
# open tabs refreshing at once don't log the user out. 0 disables the grace window.
JWT_REFRESH_GRACE_SECONDS=60

# ─── Superadmin (seeded automatically on first run) ──────────────────────────
SUPERADMIN_EMAIL=owner@example.com
SUPERADMIN_NAME=Robert Smith
SUPERADMIN_PASSWORD=change-this-strong-password-immediately       # ← CHANGE THIS

# ─── File storage: S3-compatible (SeaweedFS, the `storage` service) ───────────
# The variable names date from the earlier MinIO setup; any S3-compatible service works.
MINIO_ENDPOINT=storage:9000
MINIO_ACCESS_KEY=granary
MINIO_SECRET_KEY=change-this-storage-secret                        # ← CHANGE THIS
MINIO_BUCKET_DOCUMENTS=granary-documents
MINIO_BUCKET_ASSETS=granary-assets
# The only bucket anyone may read (branding, website product images); assets and documents are private.
MINIO_BUCKET_PUBLIC=granary-public
MINIO_USE_SSL=false
# Where the browser reaches the storage: public-bucket links and short presigned links to private files are built
# on it (and signed for its host). In production: the nginx /minio/ location on the ERP domain.
MINIO_PUBLIC_URL=https://granary.example.com/minio              # ← adjust if needed

# ─── WhatsApp Service ────────────────────────────────────────────────────────
WHATSAPP_SERVICE_URL=http://whatsapp:3001
WHATSAPP_SERVICE_TOKEN=change-this-whatsapp-service-token         # ← CHANGE THIS
WHATSAPP_BUSINESS_NUMBER=15550100000   # your WhatsApp number, international form, digits only
# WhatsApp Web build whose page shell the service loads from its cache (whatsapp_cache volume;
# list: docker compose exec whatsapp ls /whatsapp_cache/wwebjs_version). Note: this only pins the
# HTML shell — WhatsApp still loads and can update its code, so the build actually running may
# differ. The logs show it as `webVersionRunning` (and warn when it isn't this one). The service
# patches whatsapp-web.js's known breakages at runtime; a version that isn't cached falls back to live.
WWEBJS_WEB_VERSION=2.3000.1048004567

# ─── Internal services ───────────────────────────────────────────────────────
# PDF renderer (headless Chromium) — quotations, invoices, signed documents, transcripts
PDF_SERVICE_URL=http://pdf:3002
PDF_SERVICE_TOKEN=change-this-pdf-service-token                   # ← CHANGE THIS
# Extra hosts the PDF renderer may load images from (comma-separated). The storage is always allowed.
# PDF_ASSET_HOSTS=

# Face engine (ONNX Runtime) — clock-in/out face matching and liveness, self-hosted
FACE_SERVICE_URL=http://face:3003
FACE_SERVICE_TOKEN=change-this-face-service-token                 # ← CHANGE THIS
# Face analyses the engine runs at once (each one is CPU-heavy).
# FACE_MAX_CONCURRENT=2

# Web research — the research sidecar reads company websites; SearXNG (self-hosted) finds pages.
# Also pick "SearXNG" under Settings → Nary & AI → Web research.
RESEARCH_SERVICE_URL=http://research:3004
RESEARCH_SERVICE_TOKEN=change-this-research-service-token         # ← CHANGE THIS
SEARXNG_SECRET=change-this-searxng-secret                         # ← CHANGE THIS (openssl rand -hex 32)

# Speech-to-text (Nary): customer WhatsApp voice notes and the Owner's debriefs, on this server only.
STT_SERVICE_URL=http://stt:3005
STT_SERVICE_TOKEN=change-this-stt-service-token                   # ← CHANGE THIS
# Model size (tiny | base | small | medium; small suits voice notes on a CPU) and its CPU share.
# STT_MODEL=small
# STT_CPUS=1.5
# STT_THREADS=1

# ─── WebRTC / Video Calls ────────────────────────────────────────────────────
# Signal service is the WebRTC signalling server (services/signal).
# It authenticates calls with SIGNAL_TICKET_KEY (above).
SIGNAL_SERVICE_URL=ws://signal:3003   # backend-to-signal (internal Docker network — never expose to browsers)

# coturn TURN/STUN server
# TURN_SECRET must match the --static-auth-secret in coturn config.
# Generate with: openssl rand -hex 32
TURN_SECRET=change_me_turn_secret                                 # ← CHANGE THIS
# Your server's public IP address (used by coturn --external-ip).
TURN_EXTERNAL_IP=1.2.3.4                                          # ← CHANGE THIS
# TURN URIs returned to WebRTC clients. Add "turns:granary.example.com:5349" only after giving coturn a TLS
# certificate (the cert=/pkey= lines in infra/coturn/turnserver.conf; see docs/CONFIGURATION.md section 14).
TURN_URIS=["turn:granary.example.com:3478"]

# ─── E-signature (PAdES platform seal) ───────────────────────────────────────
# Signed documents are sealed with the certificate at SIGN_CERT_P12_PATH (the signing_keys
# volume). If none is there, a self-signed one is generated on first use. For trusted /
# legally certified signing, place a CA-issued .p12 there and set its password.
SIGN_CERT_P12_PATH=/keys/platform.p12
SIGN_CERT_P12_PASSWORD=
SIGN_SEAL_NAME="Your Company Ltd"
SIGN_REASON="Sealed via Granary e-signature"
SIGN_LOCATION=Tokyo
# Optional RFC 3161 timestamp authority (enables long-term validation, PAdES-B-LTA).
SIGN_TSA_URL=
# eIDAS qualified signatures: only enable with a genuine EU-qualified certificate installed.
# The QTSP settings are reserved; no remote signing provider is wired up yet.
SIGN_QES_ENABLED=false
SIGN_QTSP_URL=
SIGN_QTSP_API_KEY=

# ─── Multi-currency ──────────────────────────────────────────────────────────
# ExchangeRate-API key for the automatic 6-hourly FX sync (free tier at exchangerate-api.com).
# Optional: use in the functional currency only needs no key. A key saved in Settings → Money & tax → Currencies is used
# for the manual "Sync Now" / "Test Connection" buttons.
EXCHANGERATE_API_KEY=

# ─── CORS ────────────────────────────────────────────────────────────────────
CORS_ORIGINS=["https://granary.example.com","http://localhost:3000"]

# ─── Email ───────────────────────────────────────────────────────────────────
# SMTP credentials are stored encrypted in the database and managed via
# Settings → Email & WhatsApp in the ERP UI (superadmin only).  No SMTP vars belong here.

# ─── AI (assistant, CRM enrichment, reply drafts, document analysis) ─────────
# Provider (Anthropic, Gemini, OpenAI / compatible, DeepSeek, Ollama), API keys, models, embeddings,
# budget, persona and web research are configured in Settings → Nary & AI and stored encrypted in the
# database. No AI env vars belong here.

# ─── Company / Branding ──────────────────────────────────────────────────────
# Company name, address, tax IDs, logo, and document signing details are stored
# in the database (system_settings table) and edited via Settings → Company & branding.
# No env vars required for company identity data.
