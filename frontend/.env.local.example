# ─── Frontend environment variables ─────────────────────────────────────────
# For local development only.  In Docker, these come from the root .env file
# via env_file and build args in docker-compose.yml.
#
# Copy to .env.local for local `npm run dev`.

# NextAuth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=same-value-as-JWT_SECRET_KEY-in-root-env

# Server-side API URL (used by Next.js rewrites and auth.ts — never exposed to browser)
# Must point directly to the backend; never use the public domain here.
INTERNAL_API_URL=http://localhost:8000   # or http://backend:8000 if running inside Docker

# Public API URL baked into the client bundle (used by clock page and WebSocket URLs)
# In production this is set via the NEXT_PUBLIC_API_URL Docker build arg from API_URL.
NEXT_PUBLIC_API_URL=http://localhost:8000

# WebRTC signal service WebSocket URL (baked into the client bundle at build time)
NEXT_PUBLIC_SIGNAL_URL=ws://localhost:3003
